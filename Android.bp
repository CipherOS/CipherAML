android_app {
    name: "CipherAML",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],

    // We only need @SystemApi surfaces, not hidden internals, so build
    // against the system SDK. That keeps us portable across ROM trees.
    sdk_version: "system_current",
    min_sdk_version: "34",

    privileged: true,
    system_ext_specific: true,

    required: [
        "privapp-permissions-com.cipheros.cipheraml.xml",
        "default-permissions-com.cipheros.cipheraml.xml",
    ],
}

// Host side tests for the transport agnostic bits in core/. Those classes
// stay free of Android dependencies so they can run on a plain JVM:
//   atest CipherAMLHostTests
java_test_host {
    name: "CipherAMLHostTests",
    srcs: [
        "src/com/cipheros/cipheraml/core/**/*.java",
        "tests/host/src/**/*.java",
    ],
    static_libs: ["junit"],
    test_options: {
        unit_test: true,
    },
    test_suites: ["general-tests"],
}

// Privileged permission allowlist. Must be on the same partition as the app.
prebuilt_etc {
    name: "privapp-permissions-com.cipheros.cipheraml.xml",
    src: "etc/permissions/privapp-permissions-com.cipheros.cipheraml.xml",
    sub_dir: "permissions",
    filename_from_src: true,
    system_ext_specific: true,
}

// Runtime permissions granted on first boot.
prebuilt_etc {
    name: "default-permissions-com.cipheros.cipheraml.xml",
    src: "etc/default-permissions/default-permissions-com.cipheros.cipheraml.xml",
    sub_dir: "default-permissions",
    filename_from_src: true,
    system_ext_specific: true,
}
