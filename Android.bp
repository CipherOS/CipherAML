android_app {
    name: "CipherAML",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],

    // We only need @SystemApi surfaces, not hidden internals, so build
    // against the system SDK. That keeps us portable across ROM trees.
    sdk_version: "system_current",
    min_sdk_version: "34",

    privileged: true,
    system_ext_specific: true,
}
