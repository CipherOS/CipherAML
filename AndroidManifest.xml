<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.cipheros.cipheraml">

    <!-- Tells us when an emergency call or emergency SMS goes out. -->
    <uses-permission android:name="android.permission.READ_ACTIVE_EMERGENCY_SESSION" />

    <!-- Location. LOCATION_BYPASS lets us get a fix with location turned off. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.LOCATION_BYPASS" />

    <!-- IMEI, IMSI and MSISDN for the AML message. -->
    <uses-permission android:name="android.permission.READ_PRIVILEGED_PHONE_STATE" />

    <!--
        SMS transport. MODIFY_PHONE_STATE is what lets us send without the
        message landing in the user's sent folder.
    -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.MODIFY_PHONE_STATE" />

    <!-- HTTPS transport. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Keeps the CPU up for the few seconds a session runs. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
        The process is persistent and direct boot aware on purpose. An
        emergency call can be placed from the lock screen right after a
        reboot, before the user has ever unlocked, and we need to be up
        and listening when that happens.
    -->
    <application
        android:name=".CipherAmlApp"
        android:label="@string/app_name"
        android:icon="@drawable/ic_emergency_location"
        android:persistent="true"
        android:directBootAware="true"
        android:defaultToDeviceProtectedStorage="true"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true">
    </application>
</manifest>
