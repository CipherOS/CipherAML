<config>
    <!--
        Allows LocationRequest.Builder#setLocationSettingsIgnored(). Some
        framework versions check this list in addition to LOCATION_BYPASS,
        so we ask for both. Without it AML still works, but only when the
        user has location switched on.
    -->
    <allow-ignore-location-settings package="com.cipheros.cipheraml" />
</config>
