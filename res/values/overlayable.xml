<!--
    What a device or ROM is allowed to change with a runtime resource
    overlay. Only preinstalled overlays (or ones signed with our key) can
    touch these. Strings and layouts are deliberately not on the list.
-->
<resources>
    <overlayable name="CipherAMLConfig">
        <policy type="product|system|vendor|odm|oem|signature">
            <item type="bool" name="config_amlEnabledByDefault" />
            <item type="integer" name="config_amlLocationTimeoutMillis" />
            <item type="integer" name="config_amlEarlySendAccuracyMeters" />
            <item type="integer" name="config_amlConfidencePercent" />
            <item type="integer" name="config_amlMinBatteryPercent" />
            <item type="integer" name="config_amlMaxCachedFixAgeMillis" />
            <item type="xml" name="aml_endpoints" />
        </policy>
    </overlayable>
</resources>
